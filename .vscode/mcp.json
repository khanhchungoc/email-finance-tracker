{
  "servers": {
    "atlassian/atlassian-mcp-server": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "microsoft/azure-devops-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "${input:ado_org}",
        "-d",
        "${input:ado_domain}"
      ]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "ado_org",
      "description": "Azure DevOps organization name"
    },
    {
      "type": "promptString",
      "id": "ado_domain",
      "description": "Azure DevOps domain, for example dev.azure.com"
    }
  ]
}
