<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SupplierOnboarding"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_SupplierOnboarding">
    <bpmn:participant id="Participant_SupplierOnboarding" name="Supplier Onboarding Process" processRef="Process_SupplierOnboarding" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SupplierOnboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_SupplierOnboarding">
      <bpmn:lane id="Lane_ProcurementManager" name="Procurement Manager">
        <bpmn:flowNodeRef>StartEvent_RequestInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitOnboardingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveUpdatedDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceUser" name="Compliance User">
        <bpmn:flowNodeRef>Task_SendMissingInfoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeAppComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformComplianceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ComplianceMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyCertificates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CertificatesValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveCorrectedCerts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeCertsValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveSupplier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_ValidateOnboardingData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AppComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCertCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SupplierRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendApprovalNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SupplierOnboarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- 1. Initiation -->
    <bpmn:startEvent id="StartEvent_RequestInitiated" name="Supplier onboarding request initiated">
      <bpmn:outgoing>SF_StartToSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:userTask id="Task_SubmitOnboardingRequest" name="Submit supplier onboarding request">
      <bpmn:incoming>SF_StartToSubmit</bpmn:incoming>
      <bpmn:outgoing>SF_SubmitToValidate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2. Initial Data Validation -->
    <bpmn:serviceTask id="Task_ValidateOnboardingData" name="Validate mandatory onboarding data">
      <bpmn:incoming>SF_SubmitToValidate</bpmn:incoming>
      <bpmn:outgoing>SF_ValidateToGWAppComplete</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_AppComplete" name="Application complete?" default="SF_AppComplete_Yes">
      <bpmn:incoming>SF_ValidateToGWAppComplete</bpmn:incoming>
      <bpmn:outgoing>SF_AppComplete_Yes</bpmn:outgoing>
      <bpmn:outgoing>SF_AppComplete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 3. Missing Information Loop -->
    <bpmn:userTask id="Task_SendMissingInfoRequest" name="Send missing information request">
      <bpmn:incoming>SF_AppComplete_No</bpmn:incoming>
      <bpmn:outgoing>SF_SendMissingInfoToReceive</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReceiveUpdatedDetails" name="Receive updated onboarding details">
      <bpmn:incoming>SF_SendMissingInfoToReceive</bpmn:incoming>
      <bpmn:outgoing>SF_ReceiveDetailsToMergeApp</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_MergeAppComplete" name="Application complete merge">
      <bpmn:incoming>SF_AppComplete_Yes</bpmn:incoming>
      <bpmn:incoming>SF_ReceiveDetailsToMergeApp</bpmn:incoming>
      <bpmn:outgoing>SF_MergeAppToReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4. Compliance Review -->
    <bpmn:userTask id="Task_PerformComplianceReview" name="Perform compliance review">
      <bpmn:incoming>SF_MergeAppToReview</bpmn:incoming>
      <bpmn:outgoing>SF_ReviewToGWCompliance</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_ComplianceMet" name="Compliance criteria met?" default="SF_Compliance_Yes">
      <bpmn:incoming>SF_ReviewToGWCompliance</bpmn:incoming>
      <bpmn:outgoing>SF_Compliance_Yes</bpmn:outgoing>
      <bpmn:outgoing>SF_Compliance_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RejectSupplier" name="Reject supplier onboarding">
      <bpmn:incoming>SF_Compliance_No</bpmn:incoming>
      <bpmn:outgoing>SF_RejectSupplierToMergeRejection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 5. Certificate Verification -->
    <bpmn:userTask id="Task_VerifyCertificates" name="Verify supplier certificates">
      <bpmn:incoming>SF_Compliance_Yes</bpmn:incoming>
      <bpmn:outgoing>SF_VerifyCertsToGWValid</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_CertificatesValid" name="Certificates valid?" default="SF_Certs_Valid">
      <bpmn:incoming>SF_VerifyCertsToGWValid</bpmn:incoming>
      <bpmn:outgoing>SF_Certs_Valid</bpmn:outgoing>
      <bpmn:outgoing>SF_Certs_Correction</bpmn:outgoing>
      <bpmn:outgoing>SF_Certs_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 6. Certificate Correction Loop -->
    <bpmn:serviceTask id="Task_SendCertCorrection" name="Send certificate correction request">
      <bpmn:incoming>SF_Certs_Correction</bpmn:incoming>
      <bpmn:outgoing>SF_SendCorrectionToReceive</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ReceiveCorrectedCerts" name="Receive corrected certificates">
      <bpmn:incoming>SF_SendCorrectionToReceive</bpmn:incoming>
      <bpmn:outgoing>SF_ReceiveCertsToMergeValid</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_MergeCertsValid" name="Certificates valid merge">
      <bpmn:incoming>SF_Certs_Valid</bpmn:incoming>
      <bpmn:incoming>SF_ReceiveCertsToMergeValid</bpmn:incoming>
      <bpmn:outgoing>SF_MergeCertsToApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 7. Rejection Path -->
    <bpmn:exclusiveGateway id="GW_MergeRejection" name="Rejection merge">
      <bpmn:incoming>SF_RejectSupplierToMergeRejection</bpmn:incoming>
      <bpmn:incoming>SF_Certs_Rejected</bpmn:incoming>
      <bpmn:outgoing>SF_MergeRejectionToSendNotif</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SendRejectionNotification" name="Send rejection notification">
      <bpmn:incoming>SF_MergeRejectionToSendNotif</bpmn:incoming>
      <bpmn:outgoing>SF_SendNotifToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_SupplierRejected" name="Supplier rejected">
      <bpmn:incoming>SF_SendNotifToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 8. Final Approval and Activation -->
    <bpmn:userTask id="Task_ApproveSupplier" name="Approve supplier onboarding">
      <bpmn:incoming>SF_MergeCertsToApprove</bpmn:incoming>
      <bpmn:outgoing>SF_ApproveToActivate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ActivateSupplier" name="Activate supplier in master data">
      <bpmn:incoming>SF_ApproveToActivate</bpmn:incoming>
      <bpmn:outgoing>SF_ActivateToSendApprovalNotif</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendApprovalNotification" name="Send approval notification">
      <bpmn:incoming>SF_ActivateToSendApprovalNotif</bpmn:incoming>
      <bpmn:outgoing>SF_SendApprovalNotifToEndOnboarded</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_SupplierOnboarded" name="Supplier onboarded">
      <bpmn:incoming>SF_SendApprovalNotifToEndOnboarded</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToSubmit" sourceRef="StartEvent_RequestInitiated" targetRef="Task_SubmitOnboardingRequest" />
    <bpmn:sequenceFlow id="SF_SubmitToValidate" sourceRef="Task_SubmitOnboardingRequest" targetRef="Task_ValidateOnboardingData" />
    <bpmn:sequenceFlow id="SF_ValidateToGWAppComplete" sourceRef="Task_ValidateOnboardingData" targetRef="GW_AppComplete" />
    <bpmn:sequenceFlow id="SF_AppComplete_Yes" name="Yes - complete" sourceRef="GW_AppComplete" targetRef="GW_MergeAppComplete" />
    <bpmn:sequenceFlow id="SF_AppComplete_No" name="No - incomplete" sourceRef="GW_AppComplete" targetRef="Task_SendMissingInfoRequest" />
    <bpmn:sequenceFlow id="SF_SendMissingInfoToReceive" sourceRef="Task_SendMissingInfoRequest" targetRef="Task_ReceiveUpdatedDetails" />
    <bpmn:sequenceFlow id="SF_ReceiveDetailsToMergeApp" sourceRef="Task_ReceiveUpdatedDetails" targetRef="GW_MergeAppComplete" />
    <bpmn:sequenceFlow id="SF_MergeAppToReview" sourceRef="GW_MergeAppComplete" targetRef="Task_PerformComplianceReview" />
    <bpmn:sequenceFlow id="SF_ReviewToGWCompliance" sourceRef="Task_PerformComplianceReview" targetRef="GW_ComplianceMet" />
    <bpmn:sequenceFlow id="SF_Compliance_Yes" name="Yes - compliant" sourceRef="GW_ComplianceMet" targetRef="Task_VerifyCertificates" />
    <bpmn:sequenceFlow id="SF_Compliance_No" name="No - non compliant" sourceRef="GW_ComplianceMet" targetRef="Task_RejectSupplier" />
    <bpmn:sequenceFlow id="SF_VerifyCertsToGWValid" sourceRef="Task_VerifyCertificates" targetRef="GW_CertificatesValid" />
    <bpmn:sequenceFlow id="SF_Certs_Valid" name="Yes - valid" sourceRef="GW_CertificatesValid" targetRef="GW_MergeCertsValid" />
    <bpmn:sequenceFlow id="SF_Certs_Correction" name="No - correction needed" sourceRef="GW_CertificatesValid" targetRef="Task_SendCertCorrection" />
    <bpmn:sequenceFlow id="SF_Certs_Rejected" name="Rejected" sourceRef="GW_CertificatesValid" targetRef="GW_MergeRejection" />
    <bpmn:sequenceFlow id="SF_SendCorrectionToReceive" sourceRef="Task_SendCertCorrection" targetRef="Task_ReceiveCorrectedCerts" />
    <bpmn:sequenceFlow id="SF_ReceiveCertsToMergeValid" sourceRef="Task_ReceiveCorrectedCerts" targetRef="GW_MergeCertsValid" />
    <bpmn:sequenceFlow id="SF_MergeCertsToApprove" sourceRef="GW_MergeCertsValid" targetRef="Task_ApproveSupplier" />
    <bpmn:sequenceFlow id="SF_ApproveToActivate" sourceRef="Task_ApproveSupplier" targetRef="Task_ActivateSupplier" />
    <bpmn:sequenceFlow id="SF_ActivateToSendApprovalNotif" sourceRef="Task_ActivateSupplier" targetRef="Task_SendApprovalNotification" />
    <bpmn:sequenceFlow id="SF_SendApprovalNotifToEndOnboarded" sourceRef="Task_SendApprovalNotification" targetRef="End_SupplierOnboarded" />
    <bpmn:sequenceFlow id="SF_RejectSupplierToMergeRejection" sourceRef="Task_RejectSupplier" targetRef="GW_MergeRejection" />
    <bpmn:sequenceFlow id="SF_MergeRejectionToSendNotif" sourceRef="GW_MergeRejection" targetRef="Task_SendRejectionNotification" />
    <bpmn:sequenceFlow id="SF_SendNotifToEndRejected" sourceRef="Task_SendRejectionNotification" targetRef="End_SupplierRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_SupplierOnboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_SupplierOnboarding" bpmnElement="Collaboration_SupplierOnboarding">
      <bpmndi:BPMNShape id="BPMNShape_Participant_SupplierOnboarding" bpmnElement="Participant_SupplierOnboarding" isHorizontal="true">
        <dc:Bounds x="60" y="40" width="2320" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_ProcurementManager" bpmnElement="Lane_ProcurementManager" isHorizontal="true">
        <dc:Bounds x="90" y="40" width="2290" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_ComplianceUser" bpmnElement="Lane_ComplianceUser" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="2290" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="90" y="470" width="2290" height="250" />
      </bpmndi:BPMNShape>

      <!-- Nodes -->
      <bpmndi:BPMNShape id="BPMNShape_StartEvent_RequestInitiated" bpmnElement="StartEvent_RequestInitiated">
        <dc:Bounds x="120" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="165" width="76" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SubmitOnboardingRequest" bpmnElement="Task_SubmitOnboardingRequest">
        <dc:Bounds x="190" y="100" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ValidateOnboardingData" bpmnElement="Task_ValidateOnboardingData">
        <dc:Bounds x="340" y="550" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_AppComplete" bpmnElement="GW_AppComplete" isMarkerVisible="true">
        <dc:Bounds x="490" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="620" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SendMissingInfoRequest" bpmnElement="Task_SendMissingInfoRequest">
        <dc:Bounds x="580" y="315" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ReceiveUpdatedDetails" bpmnElement="Task_ReceiveUpdatedDetails">
        <dc:Bounds x="730" y="100" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_MergeAppComplete" bpmnElement="GW_MergeAppComplete" isMarkerVisible="true">
        <dc:Bounds x="880" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="295" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_PerformComplianceReview" bpmnElement="Task_PerformComplianceReview">
        <dc:Bounds x="970" y="315" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_ComplianceMet" bpmnElement="GW_ComplianceMet" isMarkerVisible="true">
        <dc:Bounds x="1120" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1105" y="295" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_RejectSupplier" bpmnElement="Task_RejectSupplier">
        <dc:Bounds x="1210" y="400" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_VerifyCertificates" bpmnElement="Task_VerifyCertificates">
        <dc:Bounds x="1210" y="315" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_CertificatesValid" bpmnElement="GW_CertificatesValid" isMarkerVisible="true">
        <dc:Bounds x="1360" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1345" y="295" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SendCertCorrection" bpmnElement="Task_SendCertCorrection">
        <dc:Bounds x="1450" y="500" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ReceiveCorrectedCerts" bpmnElement="Task_ReceiveCorrectedCerts">
        <dc:Bounds x="1600" y="315" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_MergeCertsValid" bpmnElement="GW_MergeCertsValid" isMarkerVisible="true">
        <dc:Bounds x="1750" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1735" y="295" width="80" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_GW_MergeRejection" bpmnElement="GW_MergeRejection" isMarkerVisible="true">
        <dc:Bounds x="1360" y="585" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1350" y="640" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SendRejectionNotification" bpmnElement="Task_SendRejectionNotification">
        <dc:Bounds x="1450" y="585" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End_SupplierRejected" bpmnElement="End_SupplierRejected">
        <dc:Bounds x="1600" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1585" y="645" width="67" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ApproveSupplier" bpmnElement="Task_ApproveSupplier">
        <dc:Bounds x="1840" y="315" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_ActivateSupplier" bpmnElement="Task_ActivateSupplier">
        <dc:Bounds x="1990" y="550" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_SendApprovalNotification" bpmnElement="Task_SendApprovalNotification">
        <dc:Bounds x="2140" y="550" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End_SupplierOnboarded" bpmnElement="End_SupplierOnboarded">
        <dc:Bounds x="2290" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2275" y="615" width="67" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_SF_StartToSubmit" bpmnElement="SF_StartToSubmit">
        <di:waypoint x="156" y="140" />
        <di:waypoint x="190" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_SubmitToValidate" bpmnElement="SF_SubmitToValidate">
        <di:waypoint x="300" y="140" />
        <di:waypoint x="395" y="140" />
        <di:waypoint x="395" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_ValidateToGWAppComplete" bpmnElement="SF_ValidateToGWAppComplete">
        <di:waypoint x="450" y="590" />
        <di:waypoint x="490" y="590" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_AppComplete_Yes" bpmnElement="SF_AppComplete_Yes">
        <di:waypoint x="540" y="590" />
        <di:waypoint x="905" y="590" />
        <di:waypoint x="905" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="570" width="70" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_AppComplete_No" bpmnElement="SF_AppComplete_No">
        <di:waypoint x="515" y="565" />
        <di:waypoint x="515" y="355" />
        <di:waypoint x="580" y="355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="495" y="440" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_SendMissingInfoToReceive" bpmnElement="SF_SendMissingInfoToReceive">
        <di:waypoint x="635" y="315" />
        <di:waypoint x="635" y="140" />
        <di:waypoint x="730" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_ReceiveDetailsToMergeApp" bpmnElement="SF_ReceiveDetailsToMergeApp">
        <di:waypoint x="840" y="140" />
        <di:waypoint x="905" y="140" />
        <di:waypoint x="905" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_MergeAppToReview" bpmnElement="SF_MergeAppToReview">
        <di:waypoint x="930" y="355" />
        <di:waypoint x="970" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_ReviewToGWCompliance" bpmnElement="SF_ReviewToGWCompliance">
        <di:waypoint x="1080" y="355" />
        <di:waypoint x="1120" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_Compliance_Yes" bpmnElement="SF_Compliance_Yes">
        <di:waypoint x="1170" y="355" />
        <di:waypoint x="1210" y="355" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1145" y="335" width="80" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_Compliance_No" bpmnElement="SF_Compliance_No">
        <di:waypoint x="1145" y="380" />
        <di:waypoint x="1145" y="430" />
        <di:waypoint x="1210" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="435" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SF_RejectSupplierToMergeRejection" bpmnElement="SF_RejectSupplierToMergeRejection">
        <di:waypoint x="1320" y="430" />
        <di:waypoint x="1385" y="430" />
