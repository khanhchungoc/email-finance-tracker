<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/bioc/1.0" xmlns:color="http://www.omg.org/spec/BPMN/20100524/DI/color" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SupplierOnboarding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SupplierOnboarding">
    <bpmn:participant id="Participant_SupplierOnboarding" name="Supplier Onboarding" processRef="Process_SupplierOnboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SupplierOnboarding">
      <bpmn:lane id="Lane_ProcurementManager" name="Procurement Manager">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveUpdatedDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_ValidateData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppCompleteMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCertCorrectionReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RejectionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionNotif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendApprovalNotif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Onboarded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceUser" name="Compliance User">
        <bpmn:flowNodeRef>Task_SendMissingInfoReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformComplianceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceCriteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyCertificates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CertValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveCorrectedCerts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CertValidMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveSupplier</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Initiate" name="Supplier onboarding request initiated">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit supplier onboarding request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateData" name="Validate mandatory onboarding data">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AppComplete" name="Application complete?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendMissingInfoReq" name="Send missing information request">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveUpdatedDetails" name="Receive updated onboarding details">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_MissingInfoTimeout" name="No response received in time" attachedToRef="Task_ReceiveUpdatedDetails">
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_AppCompleteMerge" name="Application complete merge">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PerformComplianceReview" name="Perform compliance review">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ComplianceCriteria" name="Compliance criteria met?" default="Flow_11">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RejectSupplier" name="Reject supplier onboarding">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyCertificates" name="Verify supplier certificates">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CertValid" name="Certificates valid?" default="Flow_16">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendCertCorrectionReq" name="Send certificate correction request">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveCorrectedCerts" name="Receive corrected certificates">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_CertCorrectionTimeout" name="No response received in time" attachedToRef="Task_ReceiveCorrectedCerts">
      <bpmn:outgoing>Flow_T2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_2" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_CertValidMerge" name="Certificates valid merge">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RejectionMerge" name="Rejection merge">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:incoming>Flow_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRejectionNotif" name="Send rejection notification">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Supplier rejected">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ApproveSupplier" name="Approve supplier onboarding">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ActivateSupplier" name="Activate supplier in master data">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendApprovalNotif" name="Send approval notification">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Supplier onboarded">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Initiate" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_ValidateData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateData" targetRef="Gateway_AppComplete" />
    <bpmn:sequenceFlow id="Flow_4" name="No - incomplete" sourceRef="Gateway_AppComplete" targetRef="Task_SendMissingInfoReq" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes - complete" sourceRef="Gateway_AppComplete" targetRef="Gateway_AppCompleteMerge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SendMissingInfoReq" targetRef="Task_ReceiveUpdatedDetails" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReceiveUpdatedDetails" targetRef="Gateway_AppCompleteMerge" />
    <bpmn:sequenceFlow id="Flow_T1" name="Timeout" sourceRef="Boundary_MissingInfoTimeout" targetRef="Gateway_RejectionMerge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_AppCompleteMerge" targetRef="Task_PerformComplianceReview" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_PerformComplianceReview" targetRef="Gateway_ComplianceCriteria" />
    <bpmn:sequenceFlow id="Flow_10" name="No - non compliant" sourceRef="Gateway_ComplianceCriteria" targetRef="Task_RejectSupplier" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes - compliant" sourceRef="Gateway_ComplianceCriteria" targetRef="Task_VerifyCertificates" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RejectSupplier" targetRef="Gateway_RejectionMerge" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_VerifyCertificates" targetRef="Gateway_CertValid" />
    <bpmn:sequenceFlow id="Flow_14" name="Rejected" sourceRef="Gateway_CertValid" targetRef="Gateway_RejectionMerge" />
    <bpmn:sequenceFlow id="Flow_15" name="No - correction needed" sourceRef="Gateway_CertValid" targetRef="Task_SendCertCorrectionReq" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes - valid" sourceRef="Gateway_CertValid" targetRef="Gateway_CertValidMerge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendCertCorrectionReq" targetRef="Task_ReceiveCorrectedCerts" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ReceiveCorrectedCerts" targetRef="Gateway_CertValidMerge" />
    <bpmn:sequenceFlow id="Flow_T2" name="Timeout" sourceRef="Boundary_CertCorrectionTimeout" targetRef="Gateway_RejectionMerge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_CertValidMerge" targetRef="Task_ApproveSupplier" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_RejectionMerge" targetRef="Task_SendRejectionNotif" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SendRejectionNotif" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ApproveSupplier" targetRef="Task_ActivateSupplier" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ActivateSupplier" targetRef="Task_SendApprovalNotif" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_SendApprovalNotif" targetRef="EndEvent_Onboarded" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_SupplierOnboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_SupplierOnboarding" bpmnElement="Collaboration_SupplierOnboarding">
      <bpmndi:BPMNShape id="Participant_SupplierOnboarding_di" bpmnElement="Participant_SupplierOnboarding" isHorizontal="true">
        <dc:Bounds x="20" y="80" width="2900" height="710" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ProcurementManager_di" bpmnElement="Lane_ProcurementManager" isHorizontal="true">
        <dc:Bounds x="50" y="80" width="2870" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="50" y="210" width="2870" height="290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ComplianceUser_di" bpmnElement="Lane_ComplianceUser" isHorizontal="true">
        <dc:Bounds x="50" y="500" width="2870" height="290" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Initiate_di" bpmnElement="StartEvent_Initiate" bioc:stroke="#2E7D32" bioc:fill="#E8F5E9" color:background-color="#E8F5E9" color:border-color="#2E7D32">
        <dc:Bounds x="62" y="127" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="185" y="105" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveUpdatedDetails_di" bpmnElement="Task_ReceiveUpdatedDetails" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="825" y="105" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateData_di" bpmnElement="Task_ValidateData" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="345" y="235" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AppComplete_di" bpmnElement="Gateway_AppComplete" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="535" y="250" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AppCompleteMerge_di" bpmnElement="Gateway_AppCompleteMerge" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="1015" y="250" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendCertCorrectionReq_di" bpmnElement="Task_SendCertCorrectionReq" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1785" y="235" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ActivateSupplier_di" bpmnElement="Task_ActivateSupplier" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="2425" y="235" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApprovalNotif_di" bpmnElement="Task_SendApprovalNotif" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="2585" y="235" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Onboarded_di" bpmnElement="EndEvent_Onboarded" bioc:stroke="#C62828" bioc:fill="#FFEBEE" color:background-color="#FFEBEE" color:border-color="#C62828">
        <dc:Bounds x="2782" y="257" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RejectionMerge_di" bpmnElement="Gateway_RejectionMerge" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="1655" y="410" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRejectionNotif_di" bpmnElement="Task_SendRejectionNotif" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1785" y="395" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected" bioc:stroke="#C62828" bioc:fill="#FFEBEE" color:background-color="#FFEBEE" color:border-color="#C62828">
        <dc:Bounds x="1982" y="417" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendMissingInfoReq_di" bpmnElement="Task_SendMissingInfoReq" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="665" y="525" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PerformComplianceReview_di" bpmnElement="Task_PerformComplianceReview" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1145" y="525" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ComplianceCriteria_di" bpmnElement="Gateway_ComplianceCriteria" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="1335" y="540" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectSupplier_di" bpmnElement="Task_RejectSupplier" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1305" y="685" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyCertificates_di" bpmnElement="Task_VerifyCertificates" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1465" y="525" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CertValid_di" bpmnElement="Gateway_CertValid" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="1655" y="540" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveCorrectedCerts_di" bpmnElement="Task_ReceiveCorrectedCerts" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="1945" y="525" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CertValidMerge_di" bpmnElement="Gateway_CertValidMerge" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1" color:background-color="#FFF8E1" color:border-color="#F57F17">
        <dc:Bounds x="2135" y="540" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveSupplier_di" bpmnElement="Task_ApproveSupplier" bioc:stroke="#1565C0" bioc:fill="#E3F2FD" color:background-color="#E3F2FD" color:border-color="#1565C0">
        <dc:Bounds x="2265" y="525" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Boundary_MissingInfoTimeout_di" bpmnElement="Boundary_MissingInfoTimeout">
        <dc:Bounds x="915" y="167" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CertCorrectionTimeout_di" bpmnElement="Boundary_CertCorrectionTimeout">
        <dc:Bounds x="2035" y="587" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="98" y="145" />
        <di:waypoint x="185" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="295" y="145" />
        <di:waypoint x="320" y="145" />
        <di:waypoint x="320" y="275" />
        <di:waypoint x="345" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="455" y="275" />
        <di:waypoint x="535" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" name="No - incomplete" bpmnElement="Flow_4">
        <di:waypoint x="560" y="300" />
        <di:waypoint x="560" y="565" />
        <di:waypoint x="665" y="565" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" name="Yes - complete" bpmnElement="Flow_5">
        <di:waypoint x="585" y="275" />
        <di:waypoint x="1015" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="775" y="565" />
        <di:waypoint x="800" y="565" />
        <di:waypoint x="800" y="145" />
        <di:waypoint x="825" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="935" y="145" />
        <di:waypoint x="1040" y="145" />
        <di:waypoint x="1040" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T1_di" name="Timeout" bpmnElement="Flow_T1">
        <di:waypoint x="933" y="203" />
        <di:waypoint x="933" y="445" />
        <di:waypoint x="1655" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1065" y="275" />
        <di:waypoint x="1100" y="275" />
        <di:waypoint x="1100" y="565" />
        <di:waypoint x="1145" y="565" />
