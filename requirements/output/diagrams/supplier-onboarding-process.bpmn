<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Supplier_Onboarding"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Supplier_Onboarding">
    <bpmn:participant id="Participant_Procurement_Org" name="End-to-End Supplier Onboarding Process" processRef="Process_Supplier_Onboarding" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Supplier_Onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Supplier_Onboarding">
      <bpmn:lane id="lane_procurement" name="Procurement Management">
        <bpmn:flowNodeRef>start_onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_update_resubmit_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_escalate_unsigned_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_contract_escalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_enterprise_system" name="Enterprise System">
        <bpmn:flowNodeRef>task_triage_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_triage_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_procure_corrected_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_issue_rejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_vendor_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_activate_mdm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_setup_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_parallel_setup_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_inclusive_risk_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_inclusive_risk_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_contract_event_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_signature_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_timer_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_onboarding_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_compliance" name="Compliance Team">
        <bpmn:flowNodeRef>task_request_missing_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_review_compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_audit_certificates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_cert_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_final_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_grant_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_infosec_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_trade_compliance_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_finance" name="Finance Team">
        <bpmn:flowNodeRef>task_setup_tax_payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_it_ops" name="IT Operations Team">
        <bpmn:flowNodeRef>task_provision_it_access</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_vendor" name="Supplier / Vendor">
        <bpmn:flowNodeRef>task_provide_corrected_docs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Phase 1: Initial Application & Automated Triage -->
    <bpmn:startEvent id="start_onboarding" name="Onboarding Needed">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_submit_request" name="Submit Onboarding Request">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_triage_data" name="Screen and Triage Baseline Data">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_triage_check" name="Baseline Data Complete?" default="sf_triage_pass">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_triage_pass</bpmn:outgoing>
      <bpmn:outgoing>sf_triage_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Phase 2: Application Remediation -->
    <bpmn:userTask id="task_request_missing_data" name="Request Missing Baseline Data">
      <bpmn:incoming>sf_triage_fail</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_update_resubmit_app" name="Update and Resubmit Application">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Phase 3: Due Diligence & Risk Assessment -->
    <bpmn:userTask id="task_review_compliance" name="Review Compliance and Regulatory Criteria">
      <bpmn:incoming>sf_triage_pass</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_audit_certificates" name="Audit Certificates and Credentials">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_cert_check" name="Certificates Valid?" default="sf_cert_valid">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_cert_valid</bpmn:outgoing>
      <bpmn:outgoing>sf_cert_minor_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_procure_corrected_docs" name="Request Corrected Documentation">
      <bpmn:incoming>sf_cert_minor_error</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_provide_corrected_docs" name="Provide Corrected Certificates">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Phase 4: Final Decision & MDM Activation -->
    <bpmn:exclusiveGateway id="gw_final_decision" name="Compliance Approval?" default="sf_approve_vendor">
      <bpmn:incoming>sf_cert_valid</bpmn:incoming>
      <bpmn:outgoing>sf_approve_vendor</bpmn:outgoing>
      <bpmn:outgoing>sf_reject_vendor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_issue_rejection" name="Issue Automated Rejection Notice">
      <bpmn:incoming>sf_reject_vendor</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_vendor_rejected" name="Vendor Rejected">
      <bpmn:incoming>sf_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_grant_approval" name="Grant Executive Approval">
      <bpmn:incoming>sf_approve_vendor</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_activate_mdm" name="Create and Activate MDM Profile">
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Phase 5: Concurrent Setup -->
    <bpmn:parallelGateway id="gw_parallel_setup_split" name="Initiate Concurrent Setup">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_setup_tax_payment" name="Setup Tax and Payment Routing">
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_provision_it_access" name="Provision Portal Access and Credentials">
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_parallel_setup_join" name="Synchronize Setup Completion">
      <bpmn:incoming>sf_15</bpmn:incoming>
      <bpmn:incoming>sf_16</bpmn:incoming>
      <bpmn:outgoing>sf_17</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Phase 6: Tailored Risk Profiling -->
    <bpmn:inclusiveGateway id="gw_inclusive_risk_split" name="Evaluate Risk Characteristics" default="sf_skip_specialized_risk">
      <bpmn:incoming>sf_17</bpmn:incoming>
      <bpmn:outgoing>sf_sensitive_data</bpmn:outgoing>
      <bpmn:outgoing>sf_international_trade</bpmn:outgoing>
      <bpmn:outgoing>sf_skip_specialized_risk</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="task_infosec_audit" name="Conduct InfoSec Audit">
      <bpmn:incoming>sf_sensitive_data</bpmn:incoming>
      <bpmn:outgoing>sf_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_trade_compliance_check" name="Check Cross-Border Trade Compliance">
      <bpmn:incoming>sf_international_trade</bpmn:incoming>
      <bpmn:outgoing>sf_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="gw_inclusive_risk_join" name="Converge Risk Workflows">
      <bpmn:incoming>sf_18</bpmn:incoming>
      <bpmn:incoming>sf_19</bpmn:incoming>
      <bpmn:incoming>sf_skip_specialized_risk</bpmn:incoming>
      <bpmn:outgoing>sf_20</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Phase 7: Contract Execution & Event-Based Decision -->
    <bpmn:sendTask id="task_send_contract" name="Send Contract via E-Signature Platform">
      <bpmn:incoming>sf_20</bpmn:incoming>
      <bpmn:outgoing>sf_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="gw_contract_event_split" name="Wait for Signature or Time Expiration">
      <bpmn:incoming>sf_21</bpmn:incoming>
      <bpmn:outgoing>sf_22</bpmn:outgoing>
      <bpmn:outgoing>sf_23</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="event_signature_received" name="Signature Received">
      <bpmn:incoming>sf_22</bpmn:incoming>
      <bpmn:outgoing>sf_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Signature" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="event_timer_expired" name="4-Day Time Limit Expired">
      <bpmn:incoming>sf_23</bpmn:incoming>
      <bpmn:outgoing>sf_26</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_4Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P4D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="task_send_confirmation" name="Issue Automated Onboarding Confirmation">
      <bpmn:incoming>sf_24</bpmn:incoming>
      <bpmn:outgoing>sf_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_onboarding_complete" name="Onboarding Complete">
      <bpmn:incoming>sf_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="task_escalate_unsigned_contract" name="Follow Up and Escalate Unsigned Contract">
      <bpmn:incoming>sf_26</bpmn:incoming>
      <bpmn:outgoing>sf_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_contract_escalated" name="Contract Escalated">
      <bpmn:incoming>sf_27</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="sf_1" sourceRef="start_onboarding" targetRef="task_submit_request" />
    <bpmn:sequenceFlow id="sf_2" sourceRef="task_submit_request" targetRef="task_triage_data" />
    <bpmn:sequenceFlow id="sf_3" sourceRef="task_triage_data" targetRef="gw_triage_check" />
    <bpmn:sequenceFlow id="sf_triage_pass" name="Data Complete" sourceRef="gw_triage_check" targetRef="task_review_compliance" />
    <bpmn:sequenceFlow id="sf_triage_fail" name="Missing Data" sourceRef="gw_triage_check" targetRef="task_request_missing_data" />
    <bpmn:sequenceFlow id="sf_4" sourceRef="task_request_missing_data" targetRef="task_update_resubmit_app" />
    <bpmn:sequenceFlow id="sf_5" name="Resubmitted" sourceRef="task_update_resubmit_app" targetRef="task_triage_data" />
    <bpmn:sequenceFlow id="sf_6" sourceRef="task_review_compliance" targetRef="task_audit_certificates" />
    <bpmn:sequenceFlow id="sf_7" sourceRef="task_audit_certificates" targetRef="gw_cert_check" />
    <bpmn:sequenceFlow id="sf_cert_valid" name="Valid / Correct" sourceRef="gw_cert_check" targetRef="gw_final_decision" />
    <bpmn:sequenceFlow id="sf_cert_minor_error" name="Minor Errors" sourceRef="gw_cert_check" targetRef="task_procure_corrected_docs" />
    <bpmn:sequenceFlow id="sf_8" sourceRef="task_procure_corrected_docs" targetRef="task_provide_corrected_docs" />
    <bpmn:sequenceFlow id="sf_9" name="Corrected Docs" sourceRef="task_provide_corrected_docs" targetRef="task_audit_certificates" />
    <bpmn:sequenceFlow id="sf_approve_vendor" name="Passed Compliance" sourceRef="gw_final_decision" targetRef="task_grant_approval" />
    <bpmn:sequenceFlow id="sf_reject_vendor" name="Failed / Invalid" sourceRef="gw_final_decision" targetRef="task_issue_rejection" />
    <bpmn:sequenceFlow id="sf_10" sourceRef="task_issue_rejection" targetRef="end_vendor_rejected" />
    <bpmn:sequenceFlow id="sf_11" sourceRef="task_grant_approval" targetRef="task_activate_mdm" />
    <bpmn:sequenceFlow id="sf_12" sourceRef="task_activate_mdm" targetRef="gw_parallel_setup_split" />
    <bpmn:sequenceFlow id="sf_13" sourceRef="gw_parallel_setup_split" targetRef="task_setup_tax_payment" />
    <bpmn:sequenceFlow id="sf_14" sourceRef="gw_parallel_setup_split" targetRef="task_provision_it_access" />
    <bpmn:sequenceFlow id="sf_15" sourceRef="task_setup_tax_payment" targetRef="gw_parallel_setup_join" />
    <bpmn:sequenceFlow id="sf_16" sourceRef="task_provision_it_access" targetRef="gw_parallel_setup_join" />
    <bpmn:sequenceFlow id="sf_17" sourceRef="gw_parallel_setup_join" targetRef="gw_inclusive_risk_split" />
    <bpmn:sequenceFlow id="sf_sensitive_data" name="Handles Sensitive Data" sourceRef="gw_inclusive_risk_split" targetRef="task_infosec_audit" />
    <bpmn:sequenceFlow id="sf_international_trade" name="International Vendor" sourceRef="gw_inclusive_risk_split" targetRef="task_trade_compliance_check" />
    <bpmn:sequenceFlow id="sf_skip_specialized_risk" name="Standard Vendor" sourceRef="gw_inclusive_risk_split" targetRef="gw_inclusive_risk_join" />
    <bpmn:sequenceFlow id="sf_18" sourceRef="task_infosec_audit" targetRef="gw_inclusive_risk_join" />
    <bpmn:sequenceFlow id="sf_19" sourceRef="task_trade_compliance_check" targetRef="gw_inclusive_risk_join" />
    <bpmn:sequenceFlow id="sf_20" sourceRef="gw_inclusive_risk_join" targetRef="task_send_contract" />
    <bpmn:sequenceFlow id="sf_21" sourceRef="task_send_contract" targetRef="gw_contract_event_split" />
    <bpmn:sequenceFlow id="sf_22" sourceRef="gw_contract_event_split" targetRef="event_signature_received" />
    <bpmn:sequenceFlow id="sf_23" sourceRef="gw_contract_event_split" targetRef="event_timer_expired" />
    <bpmn:sequenceFlow id="sf_24" sourceRef="event_signature_received" targetRef="task_send_confirmation" />
    <bpmn:sequenceFlow id="sf_25" sourceRef="task_send_confirmation" targetRef="end_onboarding_complete" />
    <bpmn:sequenceFlow id="sf_26" sourceRef="event_timer_expired" targetRef="task_escalate_unsigned_contract" />
    <bpmn:sequenceFlow id="sf_27" sourceRef="task_escalate_unsigned_contract" targetRef="end_contract_escalated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Supplier_Onboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Supplier_Onboarding" bpmnElement="Collaboration_Supplier_Onboarding">
      <!-- Participant Pool Shape -->
      <bpmndi:BPMNShape id="Participant_Procurement_Org_di" bpmnElement="Participant_Procurement_Org" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="3800" height="900" />
      </bpmndi:BPMNShape>

      <!-- 6 Individual Swimlane Shapes -->
      <bpmndi:BPMNShape id="lane_procurement_di" bpmnElement="lane_procurement" isHorizontal="true">
        <dc:Bounds x="60" y="0" width="3770" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_enterprise_system_di" bpmnElement="lane_enterprise_system" isHorizontal="true">
        <dc:Bounds x="60" y="150" width="3770" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_compliance_di" bpmnElement="lane_compliance" isHorizontal="true">
        <dc:Bounds x="60" y="300" width="3770" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_finance_di" bpmnElement="lane_finance" isHorizontal="true">
        <dc:Bounds x="60" y="450" width="3770" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_it_ops_di" bpmnElement="lane_it_ops" isHorizontal="true">
        <dc:Bounds x="60" y="600" width="3770" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_vendor_di" bpmnElement="lane_vendor" isHorizontal="true">
        <dc:Bounds x="60" y="750" width="3770" height="150" />
      </bpmndi:BPMNShape>

      <!-- Lane 1: Procurement Management Nodes -->
      <bpmndi:BPMNShape id="start_onboarding_di" bpmnElement="start_onboarding">
        <dc:Bounds x="90" y="57" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_request_di" bpmnElement="task_submit_request">
        <dc:Bounds x="170" y="35" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_update_resubmit_app_di" bpmnElement="task_update_resubmit_app">
        <dc:Bounds x="600" y="35" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_escalate_unsigned_contract_di" bpmnElement="task_escalate_unsigned_contract">
        <dc:Bounds x="3450" y="35" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_contract_escalated_di" bpmnElement="end_contract_escalated">
        <dc:Bounds x="3630" y="57" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Lane 2: Enterprise System Nodes -->
      <bpmndi:BPMNShape id="task_triage_data_di" bpmnElement="task_triage_data">
        <dc:Bounds x="330" y="185" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_triage_check_di" bpmnElement="gw_triage_check" isMarkerVisible="true">
        <dc:Bounds x="490" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_procure_corrected_docs_di" bpmnElement="task_procure_corrected_docs">
        <dc:Bounds x="1150" y="185" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_issue_rejection_di" bpmnElement="task_issue_rejection">
        <dc:Bounds x="1320" y="185" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_vendor_rejected_di" bpmnElement="end_vendor_rejected">
        <dc:Bounds x="1480" y="207" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_activate_mdm_di" bpmnElement="task_activate_mdm">
        <dc:Bounds x="1680" y="185" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_setup_split_di" bpmnElement="gw_parallel_setup_split">
        <dc:Bounds x="1830" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_setup_join_di" bpmnElement="gw_parallel_setup_join">
        <dc:Bounds x="2130" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_inclusive_risk_split_di" bpmnElement="gw_inclusive_risk_split">
        <dc:Bounds x="2260" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_inclusive_risk_join_di" bpmnElement="gw_inclusive_risk_join">
        <dc:Bounds x="2580" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_contract_di" bpmnElement="task_send_contract">
        <dc:Bounds x="2710" y="185" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_contract_event_split_di" bpmnElement="gw_contract_event_split">
        <dc:Bounds x="2880" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_signature_received_di" bpmnElement="event_signature_received">
        <dc:Bounds x="3010" y="175" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_timer_expired_di" bpmnElement="event_timer_expired">
        <dc:Bounds x="3010" y="255" width="36" height="36" />
      </bpmndi:BPMNShape>
