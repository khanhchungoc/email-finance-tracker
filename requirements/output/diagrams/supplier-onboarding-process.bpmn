<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/bioc/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/20100524/DI/color"
                  id="Definitions_SupplierOnboarding"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SupplierOnboarding">
    <bpmn:participant id="Participant_ProcurementSystem" name="Supplier Onboarding Process" processRef="Process_SupplierOnboarding" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProcurementSystem">
      <bpmn:lane id="Lane_ProcurementManager" name="Procurement Manager">
        <bpmn:flowNodeRef>StartEvent_OnboardingInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReceiveUpdatedDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceUser" name="Compliance User">
        <bpmn:flowNodeRef>UserTask_SendMissingInfoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AppCompleteMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PerformComplianceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ComplianceMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RejectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_VerifyCertificates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CertificatesValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReceiveCorrectedCertificates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CertificatesValidMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ApproveOnboarding</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>ServiceTask_ValidateData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AppComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendCorrectionRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendRejectionNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ActivateMasterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendApprovalNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierOnboarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OnboardingInitiated" name="Supplier onboarding request initiated">
      <bpmn:outgoing>Flow_StartToSubmit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Procurement Manager Tasks -->
    <bpmn:userTask id="UserTask_SubmitRequest" name="Submit supplier onboarding request">
      <bpmn:incoming>Flow_StartToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToValidate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ReceiveUpdatedDetails" name="Receive updated onboarding details">
      <bpmn:incoming>Flow_SendMissingToReceiveUpdated</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveUpdatedToMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Tasks & Gateways -->
    <bpmn:serviceTask id="ServiceTask_ValidateData" name="Validate mandatory onboarding data">
      <bpmn:incoming>Flow_SubmitToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToAppCompleteGw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_AppComplete" name="Application complete?" default="Flow_AppComplete_Yes">
      <bpmn:incoming>Flow_ValidateToAppCompleteGw</bpmn:incoming>
      <bpmn:outgoing>Flow_AppComplete_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AppComplete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Compliance User Tasks & Gateways -->
    <bpmn:userTask id="UserTask_SendMissingInfoRequest" name="Send missing information request">
      <bpmn:incoming>Flow_AppComplete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_SendMissingToReceiveUpdated</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_AppCompleteMerge" name="Application complete merge">
      <bpmn:incoming>Flow_AppComplete_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_ReceiveUpdatedToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToComplianceReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_PerformComplianceReview" name="Perform compliance review">
      <bpmn:incoming>Flow_MergeToComplianceReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToComplianceGw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ComplianceMet" name="Compliance criteria met?" default="Flow_Compliance_Yes">
      <bpmn:incoming>Flow_ReviewToComplianceGw</bpmn:incoming>
      <bpmn:outgoing>Flow_Compliance_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Compliance_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_RejectSupplier" name="Reject supplier onboarding">
      <bpmn:incoming>Flow_Compliance_No</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectSupplierToNotification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_VerifyCertificates" name="Verify supplier certificates">
      <bpmn:incoming>Flow_Compliance_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyToCertificatesGw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CertificatesValid" name="Certificates valid?" default="Flow_Certificates_Yes">
      <bpmn:incoming>Flow_VerifyToCertificatesGw</bpmn:incoming>
      <bpmn:outgoing>Flow_Certificates_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Certificates_Correction</bpmn:outgoing>
      <bpmn:outgoing>Flow_Certificates_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_SendCorrectionRequest" name="Send certificate correction request">
      <bpmn:incoming>Flow_Certificates_Correction</bpmn:incoming>
      <bpmn:outgoing>Flow_SendCorrectionToReceiveCorrected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ReceiveCorrectedCertificates" name="Receive corrected certificates">
      <bpmn:incoming>Flow_SendCorrectionToReceiveCorrected</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveCorrectedToCertMerge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CertificatesValidMerge" name="Certificates valid merge">
      <bpmn:incoming>Flow_Certificates_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_ReceiveCorrectedToCertMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_CertMergeToApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ApproveOnboarding" name="Approve supplier onboarding">
      <bpmn:incoming>Flow_CertMergeToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveToActivate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_SendRejectionNotification" name="Send rejection notification">
      <bpmn:incoming>Flow_RejectSupplierToNotification</bpmn:incoming>
      <bpmn:incoming>Flow_Certificates_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRejectionToRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_SupplierRejected" name="Supplier rejected">
      <bpmn:incoming>Flow_SendRejectionToRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="ServiceTask_ActivateMasterData" name="Activate supplier in master data">
      <bpmn:incoming>Flow_ApproveToActivate</bpmn:incoming>
      <bpmn:outgoing>Flow_ActivateToApprovalNotif</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_SendApprovalNotification" name="Send approval notification">
      <bpmn:incoming>Flow_ActivateToApprovalNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalNotifToOnboardedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_SupplierOnboarded" name="Supplier onboarded">
      <bpmn:incoming>Flow_ApprovalNotifToOnboardedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_OnboardingInitiated" targetRef="UserTask_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_SubmitToValidate" sourceRef="UserTask_SubmitRequest" targetRef="ServiceTask_ValidateData" />
    <bpmn:sequenceFlow id="Flow_ValidateToAppCompleteGw" sourceRef="ServiceTask_ValidateData" targetRef="ExclusiveGateway_AppComplete" />
    <bpmn:sequenceFlow id="Flow_AppComplete_Yes" name="Yes - complete" sourceRef="ExclusiveGateway_AppComplete" targetRef="ExclusiveGateway_AppCompleteMerge" />
    <bpmn:sequenceFlow id="Flow_AppComplete_No" name="No - incomplete" sourceRef="ExclusiveGateway_AppComplete" targetRef="UserTask_SendMissingInfoRequest" />
    <bpmn:sequenceFlow id="Flow_SendMissingToReceiveUpdated" sourceRef="UserTask_SendMissingInfoRequest" targetRef="UserTask_ReceiveUpdatedDetails" />
    <bpmn:sequenceFlow id="Flow_ReceiveUpdatedToMerge" sourceRef="UserTask_ReceiveUpdatedDetails" targetRef="ExclusiveGateway_AppCompleteMerge" />
    <bpmn:sequenceFlow id="Flow_MergeToComplianceReview" sourceRef="ExclusiveGateway_AppCompleteMerge" targetRef="UserTask_PerformComplianceReview" />
    <bpmn:sequenceFlow id="Flow_ReviewToComplianceGw" sourceRef="UserTask_PerformComplianceReview" targetRef="ExclusiveGateway_ComplianceMet" />
    <bpmn:sequenceFlow id="Flow_Compliance_Yes" name="Yes - compliant" sourceRef="ExclusiveGateway_ComplianceMet" targetRef="UserTask_VerifyCertificates" />
    <bpmn:sequenceFlow id="Flow_Compliance_No" name="No - non compliant" sourceRef="ExclusiveGateway_ComplianceMet" targetRef="UserTask_RejectSupplier" />
    <bpmn:sequenceFlow id="Flow_RejectSupplierToNotification" sourceRef="UserTask_RejectSupplier" targetRef="ServiceTask_SendRejectionNotification" />
    <bpmn:sequenceFlow id="Flow_VerifyToCertificatesGw" sourceRef="UserTask_VerifyCertificates" targetRef="ExclusiveGateway_CertificatesValid" />
    <bpmn:sequenceFlow id="Flow_Certificates_Yes" name="Yes - valid" sourceRef="ExclusiveGateway_CertificatesValid" targetRef="ExclusiveGateway_CertificatesValidMerge" />
    <bpmn:sequenceFlow id="Flow_Certificates_Correction" name="No - correction needed" sourceRef="ExclusiveGateway_CertificatesValid" targetRef="ServiceTask_SendCorrectionRequest" />
    <bpmn:sequenceFlow id="Flow_Certificates_Rejected" name="Rejected" sourceRef="ExclusiveGateway_CertificatesValid" targetRef="ServiceTask_SendRejectionNotification" />
    <bpmn:sequenceFlow id="Flow_SendCorrectionToReceiveCorrected" sourceRef="ServiceTask_SendCorrectionRequest" targetRef="UserTask_ReceiveCorrectedCertificates" />
    <bpmn:sequenceFlow id="Flow_ReceiveCorrectedToCertMerge" sourceRef="UserTask_ReceiveCorrectedCertificates" targetRef="ExclusiveGateway_CertificatesValidMerge" />
    <bpmn:sequenceFlow id="Flow_SendRejectionToRejectedEnd" sourceRef="ServiceTask_SendRejectionNotification" targetRef="EndEvent_SupplierRejected" />
    <bpmn:sequenceFlow id="Flow_CertMergeToApprove" sourceRef="ExclusiveGateway_CertificatesValidMerge" targetRef="UserTask_ApproveOnboarding" />
    <bpmn:sequenceFlow id="Flow_ApproveToActivate" sourceRef="UserTask_ApproveOnboarding" targetRef="ServiceTask_ActivateMasterData" />
    <bpmn:sequenceFlow id="Flow_ActivateToApprovalNotif" sourceRef="ServiceTask_ActivateMasterData" targetRef="ServiceTask_SendApprovalNotification" />
    <bpmn:sequenceFlow id="Flow_ApprovalNotifToOnboardedEnd" sourceRef="ServiceTask_SendApprovalNotification" targetRef="EndEvent_SupplierOnboarded" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_SupplierOnboarding">
      <!-- Participant Pool Shape -->
      <bpmndi:BPMNShape id="Participant_ProcurementSystem_di" bpmnElement="Participant_ProcurementSystem" isHorizontal="true" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="20" y="20" width="2500" height="650" />
      </bpmndi:BPMNShape>

      <!-- Lane Shapes -->
      <bpmndi:BPMNShape id="Lane_ProcurementManager_di" bpmnElement="Lane_ProcurementManager" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="2470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ComplianceUser_di" bpmnElement="Lane_ComplianceUser" isHorizontal="true">
        <dc:Bounds x="50" y="150" width="2470" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="50" y="410" width="2470" height="260" />
      </bpmndi:BPMNShape>

      <!-- Node Shapes -->
      <!-- Procurement Manager Lane (Y Center: 90) -->
      <bpmndi:BPMNShape id="StartEvent_OnboardingInitiated_di" bpmnElement="StartEvent_OnboardingInitiated" bioc:stroke="#2E7D32" bioc:fill="#E8F5E9">
        <dc:Bounds x="90" y="72" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_SubmitRequest_di" bpmnElement="UserTask_SubmitRequest" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="180" y="50" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReceiveUpdatedDetails_di" bpmnElement="UserTask_ReceiveUpdatedDetails" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="740" y="50" width="110" height="80" />
      </bpmndi:BPMNShape>

      <!-- Compliance User Lane (Y Center: 235) -->
      <bpmndi:BPMNShape id="UserTask_SendMissingInfoRequest_di" bpmnElement="UserTask_SendMissingInfoRequest" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="580" y="195" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_AppCompleteMerge_di" bpmnElement="ExclusiveGateway_AppCompleteMerge" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1">
        <dc:Bounds x="900" y="210" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PerformComplianceReview_di" bpmnElement="UserTask_PerformComplianceReview" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1000" y="195" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_ComplianceMet_di" bpmnElement="ExclusiveGateway_ComplianceMet" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1">
        <dc:Bounds x="1160" y="210" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_RejectSupplier_di" bpmnElement="UserTask_RejectSupplier" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1270" y="260" width="110" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_VerifyCertificates_di" bpmnElement="UserTask_VerifyCertificates" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1270" y="175" width="110" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_CertificatesValid_di" bpmnElement="ExclusiveGateway_CertificatesValid" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1">
        <dc:Bounds x="1430" y="187.5" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReceiveCorrectedCertificates_di" bpmnElement="UserTask_ReceiveCorrectedCertificates" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1700" y="175" width="110" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_CertificatesValidMerge_di" bpmnElement="ExclusiveGateway_CertificatesValidMerge" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1">
        <dc:Bounds x="1860" y="187.5" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ApproveOnboarding_di" bpmnElement="UserTask_ApproveOnboarding" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1960" y="175" width="110" height="75" />
      </bpmndi:BPMNShape>

      <!-- System Lane (Y Center: 475) -->
      <bpmndi:BPMNShape id="ServiceTask_ValidateData_di" bpmnElement="ServiceTask_ValidateData" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="330" y="435" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_AppComplete_di" bpmnElement="ExclusiveGateway_AppComplete" isMarkerVisible="true" bioc:stroke="#F57F17" bioc:fill="#FFF8E1">
        <dc:Bounds x="480" y="450" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SendCorrectionRequest_di" bpmnElement="ServiceTask_SendCorrectionRequest" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1540" y="435" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SendRejectionNotification_di" bpmnElement="ServiceTask_SendRejectionNotification" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="1540" y="530" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_SupplierRejected_di" bpmnElement="EndEvent_SupplierRejected" bioc:stroke="#C62828" bioc:fill="#FFEBEE">
        <dc:Bounds x="1710" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ActivateMasterData_di" bpmnElement="ServiceTask_ActivateMasterData" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="2110" y="435" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SendApprovalNotification_di" bpmnElement="ServiceTask_SendApprovalNotification" bioc:stroke="#1565C0" bioc:fill="#E3F2FD">
        <dc:Bounds x="2260" y="435" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_SupplierOnboarded_di" bpmnElement="EndEvent_SupplierOnboarded" bioc:stroke="#C62828" bioc:fill="#FFEBEE">
        <dc:Bounds x="2410" y="457" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- 100% Orthogonal Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_StartToSubmit_di" bpmnElement="Flow_StartToSubmit">
        <di:waypoint x="126" y="90" />
        <di:waypoint x="180" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SubmitToValidate_di" bpmnElement="Flow_SubmitToValidate">
        <di:waypoint x="290" y="90" />
        <di:waypoint x="385" y="90" />
        <di:waypoint x="385" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidateToAppCompleteGw_di" bpmnElement="Flow_ValidateToAppCompleteGw">
        <di:waypoint x="440" y="475" />
        <di:waypoint x="480" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AppComplete_Yes_di" bpmnElement="Flow_AppComplete_Yes">
        <di:waypoint x="530" y="475" />
        <di:waypoint x="925" y="475" />
        <di:waypoint x="925" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AppComplete_No_di" bpmnElement="Flow_AppComplete_No">
        <di:waypoint x="505" y="450" />
        <di:waypoint x="505" y="235" />
        <di:waypoint x="580" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendMissingToReceiveUpdated_di" bpmnElement="Flow_SendMissingToReceiveUpdated">
        <di:waypoint x="635" y="195" />
        <di:waypoint x="635" y="90" />
        <di:waypoint x="740" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReceiveUpdatedToMerge_di" bpmnElement="Flow_ReceiveUpdatedToMerge">
        <di:waypoint x="850" y="90" />
        <di:waypoint x="925" y="90" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MergeToComplianceReview_di" bpmnElement="Flow_MergeToComplianceReview">
        <di:waypoint x="950" y="235" />
        <di:waypoint x="1000" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewToComplianceGw_di" bpmnElement="Flow_ReviewToComplianceGw">
        <di:waypoint x="1110" y="235" />
        <di:waypoint x="1160" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Compliance_Yes_di" bpmnElement="Flow_Compliance_Yes">
        <di:waypoint x="1210" y="235" />
        <di:waypoint x="1270" y="235" />
        <di:waypoint x="1270" y="213" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Compliance_No_di" bpmnElement="Flow_Compliance_No">
        <di:waypoint x="1185" y="260" />
        <di:waypoint x="1185" y="288" />
        <di:waypoint x="1270" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectSupplierToNotification_di" bpmnElement="Flow_RejectSupplierToNotification">
        <di:waypoint x="1380" y="288" />
        <di:waypoint x="1495" y="288" />
        <di:waypoint x="1495" y="560" />
        <di:waypoint x="1540" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifyToCertificatesGw_di" bpmnElement="Flow_VerifyToCertificatesGw">
        <di:waypoint x="1380" y="213" />
        <di:waypoint x="1430" y="213" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Certificates_Yes_di" bpmnElement="Flow_Certificates_Yes">
        <di:waypoint x="1455" y="188" />
        <di:waypoint x="1455" y="170" />
        <di:waypoint x="1885" y="170" />
        <di:waypoint x="1885" y="188" />
      </bpmndi:BPMNEdge>
